void clearTile() {
    uint lid = gl_LocalInvocationID.x;
    // clear tile: 4096 cells / 512 threads = 16 cells per thread
    for (uint i = lid; i < TILE_SIZE * TILE_SIZE; i += THREAD_COUNT) {
        uint x = i % TILE_SIZE;
        uint y = i / TILE_SIZE; //can be replaced by bit shift if TILE_SIZE is power of 2
        localTile[x * 2 + 0][y] = 0.0;
        localTile[x * 2 + 1][y] = 0.0;
    }
}

void flushTile(uvec2 tileBasePx) {
    uint lid = gl_LocalInvocationID.x;
    for (uint i = lid; i < TILE_SIZE * TILE_SIZE; i += THREAD_COUNT) {
        uint x = i % TILE_SIZE;
        uint y = i / TILE_SIZE; //can be replaced by bit shift if TILE_SIZE is power of 2
        ivec2 pixel = ivec2(x, y) + ivec2(tileBasePx);
        if (pixel.x < uResolution.x && pixel.y < uResolution.y) {
            float tempAccumulated = localTile[x * 2 + 0][y];
            float lumi = localTile[x * 2 + 1][y];
            imageAtomicAdd(uInterleavedAccumulationBuffer, pixel * ivec2(2,1) + ivec2(0,0), tempAccumulated); //can we optimize this by writing 4 channels at once and doing 4-strides?
            imageAtomicAdd(uInterleavedAccumulationBuffer, pixel * ivec2(2,1) + ivec2(1,0), lumi);
        }
    }
}

uvec4 unpackUvec4(uint v) {
    uvec4 unpacked;
    unpacked.x = (v & uint(0xff000000)) >> 24;
    unpacked.y = (v & uint(0x00ff0000)) >> 16;
    unpacked.z = (v & uint(0x0000ff00)) >> 8;
    unpacked.w = (v & uint(0x000000ff)) >> 0;
    return unpacked;
}

vec3 decodeStarPosition(uint p) {
    uvec3 posUint = uvec3(
        (p >> 20) & 0x3ff,
        (p >> 10) & 0x3ff,
        (p >>  0) & 0x3ff
    );

    return vec3(posUint) / float(0x3ff);
}

vec3 toScreen(vec3 pos) {
    vec3 ret = vec3(-1);

    // Clip Space
    vec4 clip = vec4(0.0);
    clip = uViewProj * vec4(pos * 10000000000.0, 1.0);

    if (clip.w <= 0.0) return ret;

    // NDC
    vec3 ndc = clip.xyz / clip.w;
    if (abs(ndc.x) > 1.0 || abs(ndc.y) > 1.0 || abs(ndc.z) > 1.0)
        return ret;

    // Pixel-Koordinaten
    vec3 pixel;
    pixel.x = float((ndc.x * 0.5 + 0.5) * float(uResolution.x));
    pixel.y = float((ndc.y * 0.5 + 0.5) * float(uResolution.y));
    pixel.z = ndc.z;

    if (pixel.x < 0 || pixel.x >= uResolution.x ||
        pixel.y < 0 || pixel.y >= uResolution.y)
        return ret;

    return pixel;
}

float rand(float n){
    return abs(fract(sin(n) * 43758.5453123));
}

// Decode magnitude from upper 16 bits
float decodeMag(uint magTemp)
{
    uint magEnc = magTemp >> 16;          // upper 16 bits
    float f = float(magEnc) / 65535.0;    // back to [0,1]
    return f * 30.0 - 10.0;               // undo (mag + 10) / 30
}

// Decode temperature from lower 16 bits
float decodeTemp(uint magTemp)
{
    uint tempEnc = magTemp & 0xFFFFu;     // lower 16 bits
    return float(tempEnc);                // direct mapping
}

void writePixel(ivec2 tile_local_pos, ivec2 pixel, float temp, float lumi) {
    //lumi *= 0.05;
    //return;
    if (
        tile_local_pos.x >= 0  && tile_local_pos.y >= 0  &&
        tile_local_pos.x < TILE_SIZE && tile_local_pos.y < TILE_SIZE
    ) {
        uvec2 p = uvec2(tile_local_pos);
        atomicAdd(localTile[p.x * 2 + 0][p.y], temp * lumi);
        atomicAdd(localTile[p.x * 2 + 1][p.y], lumi);
    }
    else{            
        //interleaved 32 bit luminance-weighted temperature + 32 bit luminance store
        imageAtomicAdd(uInterleavedAccumulationBuffer, pixel * ivec2(2,1) + ivec2(0,0), temp * lumi); //can we optimize this by writing 4 channels at once and doing 4-strides?
        imageAtomicAdd(uInterleavedAccumulationBuffer, pixel * ivec2(2,1) + ivec2(1,0), lumi);
    }
}

mat3 rotY(float a) {
    float c = cos(a), s = sin(a);
    return mat3(
        vec3( c, 0,-s),
        vec3( 0, 1, 0),
        vec3( s, 0, c)
    );
}

