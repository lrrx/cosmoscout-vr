#extension GL_NV_shader_atomic_float : enable

layout(local_size_x = THREAD_COUNT, local_size_y = 1) in;

layout(binding = 0, r32f) coherent uniform image2D uInterleavedAccumulationBuffer;
layout(binding = 1, rgba8) coherent uniform image2D uFrameBuffer;

uniform mat4 uViewProj;
uniform mat4 uInvP;
uniform ivec2 uResolution;
uniform float uChunkSize;
uniform vec3 uObserverPosWorld; // observer position in same coords/units as global_pos (parsecs)
uniform float uTime;

struct ChunkMeta { //TODO: make all batches of chunk equal size, for workload distribution
    uint startRowNum; //where in batch memory does the first batch start; (1 step = 512 x 512 x 4 bytes)
    uint rowCount; //how many batches in this chunk
    uint pad0; //leftover point rows in last batch
    uint chunkID; //unique location bound id, multiple batches can be assigned to one id
};

struct Job {
    uint count;
    uint pad0;
    uint pad1;
    uint tileID_flat;
    ChunkMeta list[MAX_TILE_CHUNKS];
};

layout(std430, binding = 2) readonly buffer GpuJobsSSBO {
    Job joblist[];
};

layout(std430, binding = 0) readonly buffer GpuBatchesFlatSSBO {
    uint batchesFlat[];
};

layout(std430, binding = 4) buffer GpuProfilingSSBO {
    uint profiling_StarsDrawn;
    uint profiling_ChunksDrawn;
    uint profiling_TilesDrawn;
    uint profiling_StarsTotal;
    uint profiling_JobCount;
};

