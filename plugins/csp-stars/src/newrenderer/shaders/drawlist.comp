#version 460 core

layout(local_size_x = 64) in;

#define NUM_PRIMARY_TILES 510
uniform uint uMAX_JOB_WORK; //TODO: figure out how to split heavy chunks up (perhaps drop "chunk" concept and just use raw batches with ivec8 anchor) or turn batch <-> chunk into one thing, where we can just overlay chunks if they're too dense
uniform uint uMIN_CHUNK_WORK;
uniform uint uMAX_CHUNK_WORK;


struct ChunkMeta {
    uint startBatch;
    uint batchCount;
    uint lastBatchRowCount;
    uint chunkID;
};

struct Job {
    uint count;
    uint work; //workload of this job (number of rows)
    uint pad1;
    uint tileID_flat;
    ChunkMeta list[MAX_TILE_CHUNKS]; //IDEA: just limit this an distribute tiles to workgroups equally
};

// First 12 bytes are the indirect dispatch args; same buffer is bound as
// GL_SHADER_STORAGE_BUFFER (binding 5) and GL_DISPATCH_INDIRECT_BUFFER.
struct DispatchHeader {
    uint x_count;        // == total jobs allocated (primaries + overflow)
    uint y_count;        // == 1
    uint z_count;        // == 1
    uint pad0;
    uint tip_pointers[NUM_PRIMARY_TILES];   // current write target per tile
};

layout(std430, binding = 1) readonly buffer GpuChunkMetaSSBO { ChunkMeta chunkMetas[]; };
layout(std430, binding = 2) coherent  buffer GpuJobSSBO       { Job joblist[]; };
layout(std430, binding = 5) coherent  buffer GpuDispatchHeaderSSBO { DispatchHeader dh; };

layout(binding = 1, rgba8) coherent uniform image2D uFrameBuffer;

uniform uint    uChunkCount;
uniform mat4    uViewProj;
uniform ivec2   uResolution;
uniform float   uChunkSize;

uvec4 unpackUvec4(uint v) {
    uvec4 unpacked;
    unpacked.x = (v & uint(0xff000000)) >> 24;
    unpacked.y = (v & uint(0x00ff0000)) >> 16;
    unpacked.z = (v & uint(0x0000ff00)) >> 8;
    unpacked.w = (v & uint(0x000000ff)) >> 0;
    return unpacked;
}

ivec2 toScreen(vec3 pos) {
    vec4 clip = uViewProj * vec4(pos * 10000000000.0, 1.0);

    if (clip.w <= 0.0) return ivec2(-1);

    vec2 ndc    = clip.xy / clip.w;
    vec2 screen = (ndc * 0.5 + 0.5) * vec2(uResolution);

    return ivec2(screen);
}

ivec2 projectToTile(vec3 chunkGlobalPos) {
    vec3 worldCenter = (vec3(chunkGlobalPos) + vec3(0.5)) * uChunkSize;
    ivec2 screenPos = toScreen(worldCenter);
    if(screenPos.x < 0) return ivec2(-1);

    return ivec2(floor(screenPos / float(TILE_SIZE)));
}

void DEBUG_drawLine(ivec2 start, ivec2 end, vec4 color) {
    vec2 x0 = start;
    vec2 x1 = end;
    float len = length(x1 - x0);
    vec2 dir = normalize(x1 - x0);
    for(int i = 0; i <= len; i++) {
        ivec2 x = ivec2(x0 + dir * float(i));
        if(x.x < 0 || x.y < 0 || x.x > uResolution.x - 1 || x.y > uResolution.y - 1) continue;
        imageStore(uFrameBuffer, x, color);
    }
}

void DEBUG_drawCross(ivec2 pos, int r, vec4 color) {
    DEBUG_drawLine(pos + ivec2(-r, 0), pos + ivec2(r, 0), color);
    DEBUG_drawLine(pos + ivec2(0, -r), pos + ivec2(0, r), color);
}

void DEBUG_draw2dBox(ivec2 pos, int r, bool useCross, vec4 color) {
    for(uint j = 0; j < 4; j++) {
        ivec2 offs0 = ivec2(uvec2(j % 2, j / 2) * r);
        const uint indices[4] = uint[](1, 3, 0, 2);
        uint j1 = indices[j];
        ivec2 offs1 = ivec2(uvec2(j1 % 2, j1 / 2) * r);
        if(useCross) {
            DEBUG_drawCross(pos + offs0, r / 16, color);
        }
        else {
            DEBUG_drawLine(pos + offs0, pos + offs1, color);
        }
    }
}

void DEBUG_drawVoxelOutline(vec3 cellPos, float cellSize, vec4 color)
{
    // half‑extent
    vec3 h = vec3(cellSize * 0.5);
    cellPos += h;

    // 8 cube corners
    vec3 corner[8];
    corner[0] = cellPos + vec3(-h.x, -h.y, -h.z); // 000
    corner[1] = cellPos + vec3(+h.x, -h.y, -h.z); // 100
    corner[2] = cellPos + vec3(+h.x, +h.y, -h.z); // 110
    corner[3] = cellPos + vec3(-h.x, +h.y, -h.z); // 010

    corner[4] = cellPos + vec3(-h.x, -h.y, +h.z); // 001
    corner[5] = cellPos + vec3(+h.x, -h.y, +h.z); // 101
    corner[6] = cellPos + vec3(+h.x, +h.y, +h.z); // 111
    corner[7] = cellPos + vec3(-h.x, +h.y, +h.z); // 011

    // project to screen
    ivec2 pixelCorner[8];
    for (int i = 0; i < 8; i++)
        pixelCorner[i] = toScreen(corner[i] * uChunkSize);

    // 12 cube edges (pairs of indices)
    const ivec2 edges[12] = ivec2[12](
        ivec2(0,1), ivec2(1,2), ivec2(2,3), ivec2(3,0), // bottom face
        ivec2(4,5), ivec2(5,6), ivec2(6,7), ivec2(7,4), // top face
        ivec2(0,4), ivec2(1,5), ivec2(2,6), ivec2(3,7)  // vertical edges
    );

    // draw all edges
    for (int e = 0; e < 12; e++)
    {
        ivec2 a = pixelCorner[edges[e].x];
        ivec2 b = pixelCorner[edges[e].y];

        if (a.x < 0 || b.x < 0) continue; // your clipping rule

        DEBUG_drawLine(a, b, color);
    }
}

void enqueueChunk(uint tileID_flat, ChunkMeta data) {
    uint w = data.batchCount;

    for (uint retry = 0u; retry < 256u; ++retry) {
        uint job = dh.tip_pointers[tileID_flat];

        // Peek at work load BEFORE claiming a slot.
        // If already work-sealed, allocate a new block without dirtying this one.
        uint curWork = joblist[job].work;
        if (curWork >= uint(uMAX_JOB_WORK)) {
            if (atomicCompSwap(dh.tip_pointers[tileID_flat], job, job) == job) {
                uint newJob = atomicAdd(dh.x_count, 1u);
                joblist[newJob].count       = 0u;
                joblist[newJob].work        = 0u;
                joblist[newJob].tileID_flat = tileID_flat;
                memoryBarrierBuffer();
                atomicCompSwap(dh.tip_pointers[tileID_flat], job, newJob);
            }
            continue;
        }

        // Try to claim a slot the usual way.
        uint slot = atomicAdd(joblist[job].count, 1u);
        if (slot < MAX_TILE_CHUNKS) {
            joblist[job].list[slot] = data;
            atomicAdd(joblist[job].work, w);   // track work for the NEXT inserter to see
            return;
        }

        // Count-sealed. Settle count back to MAX, then the thread that won
        // slot == MAX allocates the next block.
        atomicAdd(joblist[job].count, 0xFFFFFFFFu); // -1
        if (slot == MAX_TILE_CHUNKS) {
            uint newJob = atomicAdd(dh.x_count, 1u);
            joblist[newJob].count       = 0u;
            joblist[newJob].work        = 0u;
            joblist[newJob].tileID_flat = tileID_flat;
            memoryBarrierBuffer();
            atomicExchange(dh.tip_pointers[tileID_flat], newJob);
        }
    }
}

#define DEBUG_GRID_OVERLAY
#define DEBUG_VISUALIZE_BINNING

void main() {
    uint i = gl_GlobalInvocationID.x;

#ifdef DEBUG_GRID_OVERLAY
    if(i < 510) {
        ivec2 tileBasePx = ivec2(i % 30, i / 30) * 64;
        DEBUG_draw2dBox(tileBasePx, 64, true, vec4(0.4,0.5,1.0,1) * 0.5);
    }
#endif

    if (i >= uChunkCount) return;

    ChunkMeta cm = chunkMetas[i];
    vec3 chunkGlobalPos = vec3(unpackUvec4(cm.chunkID).yzw) - vec3(127);
    ivec2 tile = projectToTile(chunkGlobalPos);

    ivec2 tileCount = ivec2(uResolution) / int(TILE_SIZE);
    if (tile.x < 0 || tile.x >= tileCount.x) return;
    if (tile.y < 0 || tile.y >= tileCount.y) return;

    uint tileID_flat = uint(tile.y * tileCount.x + tile.x);
    /*if(uMIN_CHUNK_WORK <= cm.batchCount && cm.batchCount <= uMAX_CHUNK_WORK)*/
    if(cm.batchCount > 2) enqueueChunk(tileID_flat, cm);


#ifdef DEBUG_VISUALIZE_BINNING
    if(tile.x == 23 && tile.y == 8) {
        ivec2 tileBasePx = tile * 64;
        ivec2 tileMidPx = tileBasePx + 32;

        ivec2 chunkOnScreenPos = toScreen((chunkGlobalPos + 0.5) * uChunkSize);
        if(chunkOnScreenPos.x >= 0 && tileMidPx.x < uResolution.x - 64 && tileMidPx.y < uResolution.y - 64) {
            
            DEBUG_drawVoxelOutline(chunkGlobalPos, 1.0, vec4(0.8,0.5,0,1));
            DEBUG_drawCross(chunkOnScreenPos, 8, vec4(1,0,0,1));
            DEBUG_drawLine(chunkOnScreenPos, tileMidPx, vec4(1,0,0,1));

            const vec4 col2 = vec4(0.1,1,0,1);

            DEBUG_drawCross(tileMidPx, 16, col2);
            DEBUG_draw2dBox(tileBasePx, 64, false, col2);
        }
    }
#endif
}