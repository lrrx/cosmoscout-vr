uint draw(uint jobID, uvec2 tileBasePx) {
    uint columnID    = gl_LocalInvocationID.x;
    uint chunkCount  = min(joblist[jobID].count, uint(MAX_TILE_CHUNKS));
    uint chunksTouched = 0u;

    for (uint i = 0u; i < chunkCount; ++i) {
        ChunkMeta meta = joblist[jobID].list[i];
        vec3 chunkGlobalPos = vec3(unpackUvec4(meta.chunkID).yzw) - vec3(127);
        bool touched = false;

        for (uint localRow = 0u; localRow < meta.rowCount; localRow++) {
            uint absRow      = meta.startRowNum + localRow;
            uint rowStartPtr = absRow * THREAD_COUNT * 2u;

            uint posEncoded     = batchesFlat[rowStartPtr + columnID * 2u + 0u];
            uint magTempEncoded = batchesFlat[rowStartPtr + columnID * 2u + 1u]; //TODO: can be moved after continue skip, but should have minor impact because if most stars are padding stars, we have some other problem

            float mag = decodeMag(magTempEncoded);
            float temp = decodeTemp(magTempEncoded);

            //if(temp < 8000.0) continue;

            starsTotal[gl_LocalInvocationID.x] += 1u;
            if (posEncoded == 0xFFFFFFFFu) continue;

            starsDrawn[gl_LocalInvocationID.x] +=
                drawStar(posEncoded, chunkGlobalPos, tileBasePx, mag, temp);
            touched = true;
        }
        if (touched) chunksTouched++;
    }
    return chunksTouched;
}

